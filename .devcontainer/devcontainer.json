{
  "name": "Ubuntu + Bun + Docker",
  "image": "vikshan/ubuntu-bun:latest",

  // Add features to the dev container, either from a Dockerfile or a list of features to install.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "WakaTime.vscode-wakatime",
        "TypeScriptTeam.native-preview",
        "eamodio.gitlens",
        "oxc.oxc-vscode"
      ]
    }
  },

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bun upd && bun bs --default",
  // Set `remoteUser` to `root` to connect as root.
  "remoteUser": "root"
}
